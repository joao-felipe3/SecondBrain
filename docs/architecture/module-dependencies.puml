@startuml module-dependencies
' Module dependency map (Backend)

skinparam backgroundColor #FFFFFF
skinparam rectangleBorderColor #333333
skinparam rectangleFontColor #111111

package "App" {
  [AppModule]
}

package "Tasks" {
  [TasksModule]
}

package "Projects" {
  [ProjectsModule]
  [PlanningModule]
  [WBSModule]
}

package "Settings" {
  [SettingsModule]
}

[AppModule] --> [TasksModule]
[AppModule] --> [ProjectsModule]
[AppModule] --> [SettingsModule]

[TasksModule] <--> [ProjectsModule] : forwardRef
[ProjectsModule] --> [PlanningModule]
[ProjectsModule] --> [WBSModule]

@enduml
