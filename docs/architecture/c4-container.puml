@startuml c4-container
' C4 Container (simplified)

skinparam backgroundColor #FFFFFF
skinparam rectangleBorderColor #333333
skinparam rectangleFontColor #111111

rectangle "User" as user
rectangle "Nuxt Frontend" as frontend
rectangle "NestJS API" as api
rectangle "MongoDB" as mongo
rectangle "Redis" as redis
rectangle "Gemini API" as gemini

user --> frontend : browser
frontend --> api : JSON over HTTPS
api --> mongo : Mongoose ODM
api --> redis : ioredis
api --> gemini : SDK

@enduml
