{
  "name": "secondbrain-monorepo",
  "version": "1.0.0",
  "description": "SecondBrain monorepo — NestJS backend + Nuxt frontend",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:backend": "cd Backend && npm run lint",
    "test:backend": "cd Backend && npm run test",
    "test:cov:backend": "cd Backend && npm run test:cov"
  },
  "overrides": {
    "fast-uri": ">=3.1.5",
    "js-yaml": ">=4.3.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0"
  },
  "lint-staged": {
    "Backend/src/**/*.ts": [
      "prettier --write"
    ],
    "Backend/tests/**/*.ts": [
      "prettier --write"
    ],
    "Frontend/**/*.{ts,vue}": [
      "prettier --write"
    ],
    "**/*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
