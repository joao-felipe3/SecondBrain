@startuml SecondBrain_ClassDiagram
!theme plain
skinparam style strictuml
skinparam handwritten false
skinparam monochrome false
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI", "Helvetica", "Arial", sans-serif
skinparam defaultFontSize 12

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.5
    FontColor #1E293B
    FontStyle bold
}

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #64748B
    BorderThickness 1.2
    HeaderBackgroundColor #F1F5F9
    FontColor #0F172A
    FontSize 12
    AttributeFontColor #334155
    AttributeFontSize 11
}

skinparam class<<entity>> {
    HeaderBackgroundColor #EEF2FF
    BorderColor #6366F1
}

skinparam class<<valueobject>> {
    HeaderBackgroundColor #ECFDF5
    BorderColor #10B981
}

skinparam class<<dto>> {
    HeaderBackgroundColor #FFFBEB
    BorderColor #F59E0B
}

skinparam class<<response>> {
    HeaderBackgroundColor #FAF5FF
    BorderColor #8B5CF6
}

skinparam enum {
    HeaderBackgroundColor #F3F4F6
    BorderColor #6B7280
}

skinparam note {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #78350F
    FontSize 11
}

skinparam arrow {
    Color #475569
    Thickness 1.2
    FontColor #334155
    FontSize 10
}

' ==========================================
' Core Data Types & Enums
' ==========================================
class ObjectId <<datatype>>

enum TaskStatus {
    + todo
    + doing
    + review
    + done
}

enum RecurringState {
    + pending
    + completed
    + skipped
}

enum MicroTaskType {
    + subtask
    + quick
    + complex
    + habit
}

enum DependencyType {
    + finish-to-start
    + start-to-start
    + finish-to-finish
}

enum WBSStatus {
    + planned
    + in-progress
    + completed
    + on-hold
}

' ==========================================
' Tasks Aggregate (Persistence)
' ==========================================
package "Tasks Domain (Persistence)" {
    class TaskChecklistItem <<valueobject>> {
        + item: string
        + completed: boolean
        + order: number
    }

    class RecurringException <<valueobject>> {
        + date: Date
        + reason: string
    }

    class TaskRecurringRule <<valueobject>> {
        + frequency: string
        + interval: number
        + daysOfWeek: number[]
        + endDate: Date
        + exceptions: RecurringException[]
    }

    class Task <<entity>> {
        + id: ObjectId
        + name: string
        + description: string
        + definitionOfDone: string
        + checklist: (string | TaskChecklistItem)[]
        + deadline: Date
        + notification: Date
        + pomodorosPlanned: number
        + pomodorosDid: number
        + pertOptimisticMinutes: number
        + pertMostLikelyMinutes: number
        + pertPessimisticMinutes: number
        + pertExpectedMinutes: number
        + pertVariance: number
        + priority: number
        + difficult: number
        + experience: number
        + prize: number
        + status: TaskStatus
        + statusUpdatedAt: Date
        + kanbanOrder: number
        + isConcluded: boolean
        + late: boolean
        + projectId: ObjectId
        + parentTaskId: ObjectId
        + parentWbsNodeId: string
        + wbsPath: string
        + generationBatchId: string
        + milestoneId: string
        + microTaskType: MicroTaskType
        + recurrency: string
        + parentRecurringId: ObjectId
        + isRecurringInstance: boolean
        + recurringState: RecurringState
        + recurringRule: TaskRecurringRule
        + requirementIds: string[]
        + journeyItemIds: string[]
        + createdAt: Date
        + updatedAt: Date
    }

    class TaskDependency <<entity>> {
        + id: ObjectId
        + projectId: ObjectId
        + taskId: ObjectId
        + dependsOnTaskId: ObjectId
        + relationship: DependencyType
        + reason: string
        + isAutoIdentified: boolean
        + createdAt: Date
        + updatedAt: Date
    }

    class Requirement <<entity>> {
        + id: ObjectId
        + projectId: ObjectId
        + description: string
        + type: string
        + kind: string
        + parentItemId: ObjectId
        + hierarchyLevel: number
        + title: string
        + traceableItems: ObjectId[]
        + traceableActionItems: ObjectId[]
        + source: string
        + status: string
        + createdAt: Date
        + updatedAt: Date
    }

    class ProjectBuffer <<entity>> {
        + id: ObjectId
        + projectId: ObjectId
        + projectBuffer: number
        + consumed: number
        + threshold: number
        + criticalPathDuration: number
        + totalVariance: number
        + standardDeviation: number
    }

    class TaskAlert <<entity>> {
        + id: ObjectId
        + taskId: ObjectId
        + projectId: ObjectId
        + alertType: string
        + message: string
        + acknowledged: boolean
        + createdAt: Date
    }

    class TaskCompletionFeedback <<entity>> {
        + id: ObjectId
        + taskId: ObjectId
        + projectId: ObjectId
        + rating: number
        + difficultyPerceived: number
        + feedbackNotes: string
        + recordedAt: Date
    }
}

' ==========================================
' Projects Aggregate (Persistence)
' ==========================================
package "Projects Domain (Persistence)" {
    class BacklogIdea <<valueobject>> {
        + text: string
        + createdAt: Date
    }

    class SmartObjective <<valueobject>> {
        + specific: string
        + measurable: string
        + achievable: string
        + relevant: string
        + temporal: string
        + weeklyHours: number
        + summary: string
        + risks: string[]
    }

    class DashboardManualVisibility <<valueobject>> {
        + spi: boolean
        + plannedVsEarned: boolean
        + completedHours: boolean
        + consistency: boolean
        + planAdherence: boolean
        + trend: boolean
        + perceivedProgress: boolean
        + remainingHours: boolean
    }

    class DashboardMetricPreferences <<valueobject>> {
        + mode: string
        + manualVisibility: DashboardManualVisibility
    }

    class Project <<entity>> {
        + id: ObjectId
        + name: string
        + description: string
        + color: string
        + startDate: Date
        + deadline: Date
        + totalHoursWorked: number
        + plannedHours: number
        + shortTermGoal: string
        + midTermGoal: string
        + longTermGoal: string
        + smartObjective: SmartObjective
        + status: string
        + progressPercentage: number
        + experience: number
        + reward: number
        + backlogIdeas: BacklogIdea[]
        + dashboardMetricPreferences: DashboardMetricPreferences
        + createdAt: Date
        + updatedAt: Date
    }

    class WBSNode <<entity>> {
        + id: string
        + projectId: string
        + name: string
        + description: string
        + level: number
        + parentId: string
        + estimatedHours: number
        + status: WBSStatus
        + order: number
        + createdAt: Date
    }

    class ProjectWave <<entity>> {
        + id: ObjectId
        + projectId: ObjectId
        + waveNumber: number
        + startDate: Date
        + endDate: Date
        + status: string
        + taskIds: ObjectId[]
        + description: string
    }

    class Risk <<entity>> {
        + id: ObjectId
        + projectId: ObjectId
        + description: string
        + probability: number
        + impact: number
        + severity: string
        + mitigationPlan: string
        + status: string
        + owner: string
        + targetResolutionDate: Date
    }

    class ProjectProgressRecord <<entity>> {
        + id: ObjectId
        + projectId: ObjectId
        + date: Date
        + completedHours: number
        + plannedValue: number
    }

    class XMatrixSnapshot <<entity>> {
        + id: ObjectId
        + projectId: ObjectId
        + data: object
        + createdAt: Date
    }
}

' ==========================================
' Settings (Persistence)
' ==========================================
package "Settings Domain (Persistence)" {
    class Settings <<entity>> {
        + id: ObjectId
        + userId: string
        + silenceNotifications: boolean
        + darkMode: boolean
        + soundEnabled: boolean
        + notificationTimeBeforeDueMinutes: number
        + createdAt: Date
        + updatedAt: Date
    }
}

' ==========================================
' Data Transfer Objects (DTOs)
' ==========================================
package "Contracts & DTOs (API Requests)" {
    class ChecklistItemDto <<dto>> {
