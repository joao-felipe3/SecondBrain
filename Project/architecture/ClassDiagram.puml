package "Analytics (API Responses)" {
    class GanttTaskItem <<response>> {
        id: string
        name: string
        startDate: string
        endDate: string
        durationHours: number
        earlyStart: number
        earlyFinish: number
        lateStart: number
        lateFinish: number
        slack: number
        isCritical: boolean
        progress: number
        isConcluded: boolean
        priority: number
        parentWbsNodeId?: string
        wbsPath?: string
    }

    class GanttDependencyItem <<response>> {
        id: string
        fromTaskId: string
        toTaskId: string
        relationship: DependencyType
        reason?: string
        isAutoIdentified: boolean
    }

    class PackageCriticalityItem <<response>> {
        packageId: string
        packagePath?: string
        taskCount: number
        criticalTaskCount: number
        criticalRatio: number
        minSlack: number
        criticalDuration: number
        criticalPathTaskCount: number
        score: number
    }

    class GanttDataResponse <<response>> {
        projectId: string
        projectName: string
        projectStartDate: string
        projectDeadline: (string|null)
        projectDurationHours: number
        tasks: GanttTaskItem[]
        dependencies: GanttDependencyItem[]
        criticalPath: string[]
        alerts: string[]
        diagnostics?: object
        packageCriticality?: PackageCriticalityItem[]
    }

    class PertDiagramNode <<response>> {
        id: string
        name: string
        durationHours: number
        earlyStart: number
        earlyFinish: number
        lateStart: number
        lateFinish: number
        slack: number
        isCritical: boolean
        progress: number
        isConcluded: boolean
        priority: number
        parentWbsNodeId?: string
        wbsPath?: string
        x: number
        y: number
    }

    class PertDiagramEdge <<response>> {
        id: string
        source: string
        target: string
        relationship: DependencyType
        reason?: string
        isAutoIdentified: boolean
        isCriticalEdge: boolean
    }

    class PertDiagramStatistics <<response>> {
        totalTasks: number
        criticalTasks: number
        criticalPercent: number
        totalEdges: number
        maxParallelism: number
    }

    class PertDiagramDataResponse <<response>> {
        projectId: string
        projectName: string
        projectDurationHours: number
        nodes: PertDiagramNode[]
        edges: PertDiagramEdge[]
        criticalPath: string[]
        alerts: string[]
        statistics: PertDiagramStatistics
        diagnostics?: object
        packageCriticality?: PackageCriticalityItem[]
    }

    class EVMForecast <<response>> {
        estimatedDate: (string|null)
        variance: number
        remainingHours: number
        completionRate: number
        bac: number
        ev: number
        pv: number
    }

    class EVMCurve <<response>> {
        plannedValue: number[]
        actualValue: number[]
        dates: string[]
    }

    class EVMDashboardManualVisibility <<response>> {
        spi: boolean
        plannedVsEarned: boolean
        completedHours: boolean
        consistency: boolean
        planAdherence: boolean
        trend: boolean
        perceivedProgress: boolean
        remainingHours: boolean
    }

    class EVMDashboardPreferences <<response>> {
        mode: string
        manualVisibility: EVMDashboardManualVisibility
    }

    class EVMMetricVisibility <<response>> {
        visible: boolean
        reason: string
    }

    class EVMMetricRelevance <<response>> {
        spi: EVMMetricVisibility
        plannedVsEarned: EVMMetricVisibility
        completedHours: EVMMetricVisibility
        consistency: EVMMetricVisibility
        planAdherence: EVMMetricVisibility
        trend: EVMMetricVisibility
        perceivedProgress: EVMMetricVisibility
        remainingHours: EVMMetricVisibility
    }

    class EVMMilestoneProgress <<response>> {
        totalMilestones: number
        completedMilestones: number
        completionRate: number
        activeMilestoneLabel: (string|null)
    }

    class EVMPersonalMetrics <<response>> {
        consistencyScore: number
        effortBalanceScore: number
        planAdherence: number
        completionTrend: string
        perceivedValueScore: number
        actionHint: string
    }

    class EVMTotals <<response>> {
        completedHours: number
        entriesCount: number
    }

    class EVMSummary <<response>> {
        spi: number
        forecast: EVMForecast
        curve: EVMCurve
        totals: EVMTotals
        personalMetrics: EVMPersonalMetrics
        milestoneProgress: EVMMilestoneProgress
        dashboardPreferences: EVMDashboardPreferences
        metricRelevance: EVMMetricRelevance
    }

    class XMatrixAxisItemDto <<response>> {
        id: string
        label: string
        source?: string
