@startuml Classes
skinparam style strictuml
left to right direction

' This diagram reflects the current Backend DTOs + persistence schemas (NestJS/Mongoose).
' It replaces early-phase placeholder classes (Workout/Product/etc) with real domain models.

class ObjectId <<datatype>>

enum TaskStatus {
    todo
    doing
    review
    done
}

enum RecurringState {
    pending
    completed
    skipped
}

enum MicroTaskType {
    subtask
    quick
    complex
    habit
}

enum DependencyType {
    finish-to-start
    start-to-start
    finish-to-finish
}

enum WBSStatus {
    planned
    in-progress
    completed
    on-hold
}

package "Tasks (Persistence)" {
    class TaskChecklistItem {
        item: string
        completed: boolean
        order: number
    }

    class RecurringException {
        date: Date
        reason: string
    }

    class TaskRecurringRule {
        frequency: string
        interval: number
        daysOfWeek: number[]
        endDate: Date
        exceptions: RecurringException[]
    }

    class Task {
        id: ObjectId
        name: string
        description: string
        definitionOfDone: string
        checklist: (string|TaskChecklistItem)[]

        deadline: Date
        notification: Date

        pomodorosPlanned: number
        pomodorosDid: number

        pertOptimisticMinutes: number
        pertMostLikelyMinutes: number
        pertPessimisticMinutes: number
        pertExpectedMinutes: number
        pertVariance: number

        priority: number
        difficult: number
        experience: number
        prize: number

        status: TaskStatus
        statusUpdatedAt: Date
        kanbanOrder: number

        isConcluded: boolean
        late: boolean

        projectId: ObjectId
        parentTaskId: ObjectId

        parentWbsNodeId: string
        wbsPath: string
        generationBatchId: string
        milestoneId: string

        microTaskType: MicroTaskType
        recurrency: string
        parentRecurringId: ObjectId
        isRecurringInstance: boolean
        recurringState: RecurringState
        recurringRule: TaskRecurringRule

        requirementIds: string[]
        journeyItemIds: string[]
        createdAt: Date
    }

    class TaskDependency {
        id: ObjectId
        projectId: ObjectId
        taskId: ObjectId
        dependsOnTaskId: ObjectId
        relationship: DependencyType
        reason: string
        isAutoIdentified: boolean
        createdAt: Date
        updatedAt: Date
    }

    class Requirement {
        id: ObjectId
        projectId: ObjectId
        description: string
        type: string
        kind: string
        parentItemId: ObjectId
        hierarchyLevel: number
        title: string
        traceableItems: ObjectId[]
        traceableActionItems: ObjectId[]
        source: string
        status: string
        createdAt: Date
        updatedAt: Date
    }

    class ProjectBuffer {
        id: ObjectId
        projectId: ObjectId
        projectBuffer: number
        consumed: number
        threshold: number
        criticalPathDuration: number
        totalVariance: number
        standardDeviation: number
    }
}

package "Projects (Persistence)" {
    class BacklogIdea {
        text: string
        createdAt: Date
    }

    class SmartObjective {
        specific: string
        measurable: string
        achievable: string
        relevant: string
        temporal: string
        weeklyHours: number
        summary: string
        risks: string[]
    }

    class DashboardManualVisibility {
        spi: boolean
        plannedVsEarned: boolean
        completedHours: boolean
        consistency: boolean
        planAdherence: boolean
        trend: boolean
        perceivedProgress: boolean
        remainingHours: boolean
    }

    class DashboardMetricPreferences {
        mode: string
        manualVisibility: DashboardManualVisibility
    }

    class Project {
        id: ObjectId
        name: string
        description: string
        color: string
        startDate: Date
        deadline: Date
        totalHoursWorked: number
        plannedHours: number
        shortTermGoal: string
        midTermGoal: string
        longTermGoal: string
        smartObjective: SmartObjective
        status: string
        progressPercentage: number
        experience: number
        reward: number
        backlogIdeas: BacklogIdea[]
        dashboardMetricPreferences: DashboardMetricPreferences
    }

    class WBSNode {
        id: string
        projectId: string
        name: string
        description: string
        level: number
        parentId: string
        estimatedHours: number
        status: WBSStatus
        order: number
        createdAt: Date
    }

    class ProjectWave {
        id: ObjectId
        projectId: ObjectId
        waveNumber: number
        startDate: Date
        endDate: Date
        status: string
        taskIds: ObjectId[]
        description: string
    }

    class Risk {
        id: ObjectId
        projectId: ObjectId
        description: string
        probability: number
        impact: number
        severity: string
        mitigationPlan: string
        status: string
        owner: string
        targetResolutionDate: Date
    }

    class XMatrixSnapshot {
        projectId: ObjectId
        data: object
    }
}

package "Settings (Persistence)" {
    class Settings {
        id: ObjectId
        userId: string
        silenceNotifications: boolean
        darkMode: boolean
        soundEnabled: boolean
        notificationTimeBeforeDueMinutes: number
        createdAt: Date
        updatedAt: Date
    }
}

