        + shortTermGoal: string
        + midTermGoal: string
        + longTermGoal: string
        + userPrompt: string
        + targetHours: number
    }

    class CreateProjectDto <<dto>> {
        + name: string
        + description: string
        + color: string
        + startDate: Date
        + deadline: Date
        + totalHoursWorked: number
        + plannedHours: number
        + shortTermGoal: string
        + midTermGoal: string
        + longTermGoal: string
        + status: string
        + progressPercentage: number
        + experience: number
        + reward: number
    }

    class SmartObjectiveDto <<dto>> {
        + specific: string
