}

' -------------------
' Relationships
' -------------------

Project "1" <-- "0..*" Task : projectId
Task "0..1" --> "0..1" Task : parentTaskId
Task "0..*" --> "0..*" Requirement : requirementIds

Project "1" --> "0..*" WBSNode : projectId
WBSNode "0..1" <-- "0..*" Task : parentWbsNodeId

Project "1" --> "0..*" TaskDependency : projectId
TaskDependency "*" --> "1" Task : taskId
TaskDependency "*" --> "1" Task : dependsOnTaskId

Project "1" --> "0..1" ProjectBuffer : buffer
Project "1" --> "0..*" Risk
Project "1" --> "0..*" ProjectWave
Project "1" --> "0..1" XMatrixSnapshot

UpdateTaskDto --|> CreateTaskDto
CreateMicroTaskDto --|> CreateTaskDto
UpdateProjectDto --|> CreateProjectDto

GanttDataResponse o-- GanttTaskItem
GanttDataResponse o-- GanttDependencyItem
GanttDataResponse o-- PackageCriticalityItem

PertDiagramDataResponse o-- PertDiagramNode
PertDiagramDataResponse o-- PertDiagramEdge
PertDiagramDataResponse o-- PertDiagramStatistics
PertDiagramDataResponse o-- PackageCriticalityItem

EVMSummary o-- EVMForecast
EVMSummary o-- EVMCurve
EVMSummary o-- EVMTotals
EVMSummary o-- EVMPersonalMetrics
EVMSummary o-- EVMMilestoneProgress
EVMSummary o-- EVMDashboardPreferences
EVMSummary o-- EVMMetricRelevance
EVMMetricRelevance o-- EVMMetricVisibility

XMatrixResponseDto o-- XMatrixAxisItemDto
XMatrixResponseDto o-- XMatrixCellDto
XMatrixResponseDto o-- XMatrixDiagnosticsDto

AiSuggestionsResponseDto o-- AiTaskSuggestionDto
AiSuggestionsResponseDto o-- AiSuggestionsProgressDto

PertEstimateResponseDto o-- PertEstimateDto

note right of Task
    Habits are represented as Tasks
    where microTaskType = 'habit'.
end note

@enduml