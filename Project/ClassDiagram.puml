@startuml Classes
skinparam style strictuml
left to right direction

class Task {
    code: String 
    name: String
    description: String 
    deadline: Date
    priority: String 
    difficult: String
    project: String
    experience: Int
    isConcluded: Boolean
    late: Boolean
    prize: Int
}

class Habit {
    frequency : String
    description : String
    BeginDate : Date
